{
  "name": "stilltype",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build-static.mjs",
    "evaluate:learner": "node scripts/evaluate-learner.mjs",
    "lint": "oxlint --deny-warnings",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:compat": "E2E_FULL=0 E2E_BROWSERS=firefox,webkit playwright test",
    "test:e2e:firefox": "E2E_FULL=1 E2E_BROWSERS=firefox playwright test",
    "test:e2e:webkit": "E2E_FULL=1 E2E_BROWSERS=webkit playwright test",
    "test:e2e:all": "E2E_FULL=1 E2E_BROWSERS=all playwright test",
    "test:e2e:changed": "playwright test --only-changed=origin/master --pass-with-no-tests",
    "test:e2e:quick": "playwright test e2e/typing.spec.js e2e/layout.spec.js e2e/chrome.spec.js e2e/practice-more.spec.js e2e/touch-targets.spec.js e2e/learning-loop.spec.js e2e/quick-restart.spec.js e2e/light-contrast.spec.js e2e/code-mode.spec.js"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "^1.63.0",
    "oxlint": "1.90.0"
  }
}
