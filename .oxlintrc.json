{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".impeccable/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "design/**",
    "dist/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    // Null comparisons (x != null) check for null and undefined together.
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],

    // suspicious
    // Helpers sit beside their one caller; hoisting 252 of them moves code away from its use for no measurable gain.
    "unicorn/consistent-function-scoping": "off",
    // toSorted() and toReversed() are ES2023, and the build and TypeScript lib target ES2022.
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // Dunder names are build-time defines (__VERSION__) and test hooks on window, and _tag is Effect's.
    "eslint/no-underscore-dangle": "off",
    // IndexedDB and FileReader handlers are assigned so cleanup can null them in one statement.
    "unicorn/prefer-add-event-listener": "off",
    // It reads a Date advanced by setDate() and constant guards beside a loop counter as stuck loops.
    "eslint/no-unmodified-loop-condition": "off",
    // Every postMessage here is a Worker's, MessagePort's or BroadcastChannel's, which take no targetOrigin.
    "unicorn/require-post-message-target-origin": "off",

    // perf
    // Sequential awaits are the intent: e2e steps, ordered sync and retries, and build steps run one after another.
    "eslint/no-await-in-loop": "off",
    // Its fix mutates the mapped objects, and records here are copied on purpose.
    "oxc/no-map-spread": "off",
    // Its fix for filter().at(-1) is findLast(), which is ES2023.
    "unicorn/prefer-array-find": "off",

    // pedantic
    // The u flag changes how ., classes and case-insensitive matches treat astral and some Latin letters, so 717 regexes can't switch unproven.
    "eslint/require-unicode-regexp": "off",
    // Size and nesting limits would mean restructuring 300 files and functions, which isn't a lint fix.
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-depth": "off",
    // Small classes (Effect errors, React components) sit beside the code that uses them.
    "eslint/max-classes-per-file": "off",
    // if (list.length) is idiomatic, and the fix changes truthiness where plain-JS parsers read a length that can be undefined.
    "unicorn/explicit-length-check": "off",
    // Named predicates and normalizers (isRecord, Number.isFinite) are passed directly; none misreads the index argument.
    "unicorn/no-array-callback-reference": "off",
    // Dropping async turns a rejection into a synchronous throw, and node:test and Playwright callbacks are async by contract.
    "eslint/require-await": "off",
    // parseFloat reads 12 from computed styles such as '12px', where Number() returns NaN.
    "unicorn/prefer-number-coercion": "off",
    // getElementById looks up an id directly; querySelector needs CSS-escaped ids.
    "unicorn/prefer-query-selector": "off",
    // Branch order follows the case the code handles first; swapping branches is preference.
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    // Trailing comments label a value on its own line, mostly in test fixtures.
    "eslint/no-inline-comments": "off",
    // Tests pass undefined to normalizers to name the missing-value case they check.
    "unicorn/no-useless-undefined": "off",
    // Object(value) returns any, which boundary parsers keep unknown; new Object(value) returns Object and trips anti-slop's widening rules.
    "unicorn/new-for-builtins": "off",
    // charCodeAt and fromCharCode read UTF-16 units on purpose: FNV hashes that seed passages, and base64 bytes.
    "unicorn/prefer-code-point": "off",
    // Merging pushes evaluates every argument first, and evaluate-learner's picks read the array between pushes.
    "unicorn/prefer-single-call": "off",
    // Each site uses appendChild's return value, which append() doesn't give.
    "unicorn/prefer-dom-node-append": "off",
    // It reads Playwright's locator.getAttribute() as the DOM method.
    "unicorn/prefer-dom-node-dataset": "off",
    // x | 0 wraps to 32 bits in the seeded PRNGs; Math.trunc() doesn't.
    "unicorn/prefer-math-trunc": "off",
    // A whole default viewport object is the intended argument.
    "unicorn/no-object-as-default-parameter": "off",
    // Callbacks in loops read outer let state on purpose; none closes over a var.
    "eslint/no-loop-func": "off",

    // "Shape" is Stilltype's term for a test's mode and length, shared with docs/ui-contract.md, DOM ids (#board-shape) and UI copy; renaming 356 symbols would split the code from that contract.
    "anti-slop/no-shape-in-symbol-names": "off",
    // typeof is how plain JS parses stored profiles and server replies (104 sites); the rule's only escape, allowInTypeGuards, needs TypeScript type predicates.
    "anti-slop/no-runtime-typeof": "off",
    // Spreads copy live NodeLists before the loop removes children, which this rule reads as useless.
    "unicorn/no-useless-spread": "off",
    // new Array(n).fill() sizes a buffer more plainly than Array.from({ length: n }).
    "unicorn/no-new-array": "off",
    // request() sends a body only when a caller passes one, which this rule can't see through the default method.
    "unicorn/no-invalid-fetch-options": "off",
    "eslint/no-unused-vars": ["warn", { "ignoreRestSiblings": true, "varsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["src/run-copy.ts"],
      "rules": {
        // Run labels consume raw retained custom-order, minimum and speed fields at their presentation boundary.
        "anti-slop/no-unknown-parameters": "off",
        // Custom-order labels preserve the original prototype-bearing lookup before display coercion.
        "anti-slop/no-reflect-get": "off"
      }
    },
    {
      "files": ["src/rematch-conditions.ts", "src/online-race.ts"],
      "rules": {
        // Inbox rematches forward raw retained conditions until passage and RPC consumers read their fields.
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["src/recorded-text.ts"],
      "rules": {
        // Retained text fields are read lazily so malformed historical values keep their original return or error behavior.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": ["src/history-selection.ts"],
      "rules": {
        // Historical property and date readers preserve raw stored values until selection consumes them.
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["src/loop-history.ts"],
      "rules": {
        // Historical comparison and timing fields stay raw until their display readers consume them.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": ["src/training-patterns.tsx"],
      "rules": {
        // Selected conditions and loop dates stay raw historical values until presentation consumes them.
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["src/words.ts", "src/code-snippets.ts"],
      "rules": {
        // Restored historical catalog selectors retain their raw identity until the existing lookup or membership check.
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": [
        "src/books.ts", "src/compose.ts", "src/custom-themes.ts", "src/fonts.ts",
        "src/insights.ts", "src/keybindings.ts", "src/layouts.ts", "src/lengths.ts", "src/lessons.ts",
        "src/profile.ts", "src/run-counts.ts", "src/typing.ts", "src/word-highlight.ts", "src/caret-glide.ts",
        "src/race-result.ts", "src/units.ts", "src/challenge-people.ts", "src/sound.ts",
        "src/domain-history.ts", "src/monkeytype.ts", "src/quick-match.ts",
        "src/wallpaper.ts", "src/wallpaper-image.ts", "src/inbox.ts", "src/friends-board.ts",
        "src/profile-sync.ts"
      ],
      "rules": {
        // These normalizers parse browser inputs and recover historical profile fields before typed use.
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["src/insights.ts"],
      "rules": {
        // Condition labels retain raw historical mode and difficulty values until final text rendering.
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": ["src/domain-values.ts", "src/profile-types.ts", "src/domain-history.ts", "src/monkeytype.ts"],
      "rules": {
        // Historical records and imported settings preserve unknown fields until their boundary parsers narrow them.
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["src/network.ts"],
      "rules": {
        // HTTP JSON stays unknown until its endpoint decoder validates it; JSON.parse must not leak any.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-known-value-widening": "off"
      }
    },
    {
      "files": ["src/network-race.ts", "src/multiplayer.ts", "src/ghost-race.ts"],
      "rules": {
        // RPC decoders validate untrusted replies before returning their named domain records.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": ["src/profile-copy.ts"],
      "rules": {
        // Legacy codecs preserve raw records and future fields without asserting normalized Profile data.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-object-parameters": "off"
      }
    },
    {
      "files": ["src/account.ts"],
      "rules": {
        // Storage recovery and legacy merges retain unrecognized fields and keep parsed JSON unknown.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["src/prepaint.ts"],
      "rules": {
        // Before-paint storage recovery must tolerate historical theme ids and raw custom token fields.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["supabase/functions/**"],
      "rules": {
        // cleanTheme is the boundary parser for the model's reply, so it takes unknown by design.
        "anti-slop/no-unknown-parameters": "off",
        // JSON reply bodies and header maps are open records by nature.
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-known-value-widening": "off"
      }
    },
    {
      "files": ["src/sw.ts"],
      "rules": {
        // export {} keeps the service worker a module for TypeScript.
        "unicorn/require-module-specifiers": "off"
      }
    },
    {
      "files": ["src/wallpaper-image.ts"],
      "rules": {
        // FileReader lets an interrupted decode abort the read, which Blob#arrayBuffer() can't.
        "unicorn/prefer-blob-reading-methods": "off"
      }
    },
    {
      "files": ["e2e/**", "tests/**", "scripts/**"],
      "rules": {
        // page.evaluate callbacks take a value under its outside name, and test helpers reuse fixture names on purpose.
        "eslint/no-shadow": "off"
      }
    },
    {
      "files": ["scripts/measure-profile.mjs"],
      "rules": {
        // The benchmark times expressions whose results it discards on purpose.
        "eslint/no-unused-expressions": "off"
      }
    }
  ]
}
