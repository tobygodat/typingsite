{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".impeccable/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "design/**",
    "dist/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-array-filter-map": "error",

    // "Shape" is Stilltype's term for a test's mode and length, shared with docs/ui-contract.md, DOM ids (#board-shape) and UI copy; renaming 356 symbols would split the code from that contract.
    "anti-slop/no-shape-in-symbol-names": "off",
    // typeof is how plain JS parses stored profiles and server replies (104 sites); the rule's only escape, allowInTypeGuards, needs TypeScript type predicates.
    "anti-slop/no-runtime-typeof": "off",
    // Spreads copy live NodeLists before the loop removes children, which this rule reads as useless.
    "unicorn/no-useless-spread": "off",
    // new Array(n).fill() sizes a buffer more plainly than Array.from({ length: n }).
    "unicorn/no-new-array": "off",
    // request() sends a body only when a caller passes one, which this rule can't see through the default method.
    "unicorn/no-invalid-fetch-options": "off",
    "eslint/no-unused-vars": ["warn", { "ignoreRestSiblings": true, "varsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": [
        "src/books.ts", "src/compose.ts", "src/custom-themes.ts", "src/fonts.ts",
        "src/insights.ts", "src/keybindings.ts", "src/layouts.ts", "src/lengths.ts", "src/lessons.ts",
        "src/profile.ts", "src/run-counts.ts", "src/typing.ts", "src/word-highlight.ts",
        "src/race-result.ts", "src/units.ts", "src/challenge-people.ts", "src/sound.ts",
        "src/domain-history.ts", "src/monkeytype.ts", "src/quick-match.ts",
        "src/wallpaper.ts", "src/wallpaper-image.ts", "src/inbox.ts", "src/friends-board.ts",
        "src/profile-sync.ts"
      ],
      "rules": {
        // These normalizers parse browser inputs and recover historical profile fields before typed use.
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["src/domain-values.ts", "src/profile-types.ts", "src/domain-history.ts", "src/monkeytype.ts"],
      "rules": {
        // Historical records and imported settings preserve unknown fields until their boundary parsers narrow them.
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["src/network.ts"],
      "rules": {
        // HTTP JSON stays unknown until its endpoint decoder validates it; JSON.parse must not leak any.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-known-value-widening": "off"
      }
    },
    {
      "files": ["src/network-race.ts", "src/multiplayer.ts", "src/ghost-race.ts"],
      "rules": {
        // RPC decoders validate untrusted replies before returning their named domain records.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": ["src/profile-copy.ts"],
      "rules": {
        // Legacy codecs preserve raw records and future fields without asserting normalized Profile data.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-object-parameters": "off"
      }
    },
    {
      "files": ["src/account.ts"],
      "rules": {
        // Storage recovery and legacy merges retain unrecognized fields and keep parsed JSON unknown.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["src/prepaint.ts"],
      "rules": {
        // Before-paint storage recovery must tolerate historical theme ids and raw custom token fields.
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["supabase/functions/**"],
      "rules": {
        // cleanTheme is the boundary parser for the model's reply, so it takes unknown by design.
        "anti-slop/no-unknown-parameters": "off",
        // JSON reply bodies and header maps are open records by nature.
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-known-value-widening": "off"
      }
    },
    {
      "files": ["scripts/measure-profile.mjs"],
      "rules": {
        // The benchmark times expressions whose results it discards on purpose.
        "eslint/no-unused-expressions": "off"
      }
    }
  ]
}
